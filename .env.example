# ===========================
# Sovereign AI Workbench
# Environment Configuration
# ===========================
# Copy this file to backend/.env and adjust values for your local setup.
# Do NOT put secrets in this file — it is committed to version control.

# Ollama configuration (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180

# Model routing — all models are local via Ollama
FAST_MODEL=qwen3:4b
REASONING_MODEL=qwen3:4b
VISION_MODEL=llava:7b
EMBEDDING_MODEL=nomic-embed-text

# Database (SQLite for prototype, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/sovereign.db

# Storage paths
DATA_DIR=./data
OUTPUT_DIR=./outputs
VECTOR_STORE_PATH=./data/vector

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# File upload
MAX_UPLOAD_SIZE_MB=50

# Report formats
REPORT_FORMATS=docx,pdf,pptx,xlsx
